# =============================================================================
# TG_parser Environment Configuration
# =============================================================================
# 
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
#
# Файл .env находится в .gitignore и не попадает в git
#

# =============================================================================
# Telegram API Credentials (обязательно для ingestion)
# =============================================================================
# Получить на https://my.telegram.org/apps

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890
# Session file path (relative paths resolved from project root).
# In Docker, set to /app/sessions/tg_parser_session (via docker-compose.yml).
TELEGRAM_SESSION_NAME=tg_parser_session


# =============================================================================
# LLM Configuration (v1.2 Multi-LLM Support)
# =============================================================================

# Выбор провайдера (default: openai)
# Опции: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai

# Опционально: переопределение модели
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_MODEL=gemini-2.0-flash-exp
# LLM_MODEL=llama3.2


# =============================================================================
# OpenAI API Key (для provider=openai)
# =============================================================================
# Получить на https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-proj-your-openai-api-key-here


# =============================================================================
# Anthropic API Key (для provider=anthropic)
# =============================================================================
# Получить на https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here


# =============================================================================
# Google Gemini API Key (для provider=gemini)
# =============================================================================
# Получить на https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your-gemini-api-key-here


# =============================================================================
# Ollama Configuration (для provider=ollama, локальные LLM)
# =============================================================================
# Ollama не требует API key, но нужен запущенный сервер
# 
# Установка:
#   brew install ollama  # macOS
#   # или скачать с https://ollama.com/download
#
# Запуск:
#   ollama serve
#   ollama pull llama3.2
#
# Base URL (default: http://localhost:11434)
# LLM_BASE_URL=http://localhost:11434


# =============================================================================
# Per-stage LLM overrides (v3.3 — optional, fallback to LLM_PROVIDER/LLM_MODEL)
# =============================================================================
# Use a cheaper/faster model for message processing and a stronger one for topicization.
# Comment out to use the global LLM_PROVIDER/LLM_MODEL for all stages.

# PROCESSING_LLM_PROVIDER=anthropic
# PROCESSING_LLM_MODEL=claude-haiku-4-5-20251001
# TOPICIZATION_LLM_PROVIDER=anthropic
# TOPICIZATION_LLM_MODEL=claude-sonnet-4-20250514
# RAG_LLM_PROVIDER=openai
# RAG_LLM_MODEL=gpt-4o
# DIGEST_LLM_PROVIDER=openai
# DIGEST_LLM_MODEL=gpt-4o-mini
# RESUMMARIZE_LLM_PROVIDER=openai           # F5-C: per-stage LLM
# RESUMMARIZE_LLM_MODEL=gpt-4o-mini         # ~100x cheaper than topicization


# =============================================================================
# LLM Processing Settings
# =============================================================================

# Temperature (0.0 = детерминизм, 1.0 = творчество)
LLM_TEMPERATURE=0.0

# Max tokens в ответе
LLM_MAX_TOKENS=4096

# Retry настройки
PROCESSING_MAX_ATTEMPTS_PER_MESSAGE=3
PROCESSING_RETRY_BACKOFF_BASE=1.0
PROCESSING_RETRY_JITTER_MAX=0.3

# Sprint D.1: пауза источника после Anthropic billing-error
# (invalid_request_error: credit balance is too low). Pipeline-loops НЕ
# ретраят такую ошибку; scheduler ставит source.rate_limit_until =
# now + BILLING_BLOCK_BACKOFF_S и инкрементит метрику
# tg_parser_anthropic_billing_block_total. Минимум 60s, по умолчанию 1h.
BILLING_BLOCK_BACKOFF_S=3600

# Anthropic prompt-caching (cache_control on long-lived prompt prefixes).
# Disable only for debugging cache bugs; cuts ~90% of repeated input tokens.
ANTHROPIC_PROMPT_CACHING_ENABLED=true

# Per-call input/output token estimate passed to the Anthropic rate limiter
# for processing-stage calls. Used as a pre-flight estimate so the limiter
# can schedule conservatively before real token counts are known.
PROCESSING_ANTHROPIC_INPUT_TOKEN_ESTIMATE=2000
PROCESSING_ANTHROPIC_OUTPUT_TOKEN_ESTIMATE=2048


# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
#
# DB_HOST has two valid values depending on context — pick ONE per ".env"
# (or override per-context via shell, see DI-18 in FUTURE_FEATURES.md):
#
#   DB_HOST=localhost   ← venv-CLI on host (tg-parser CLI hits Postgres via
#                         mapped port 127.0.0.1:5432). DEFAULT for dev.
#   DB_HOST=postgres    ← all docker compose services (talk to Postgres by
#                         compose service name inside tg_parser_network).
#
# If you primarily develop with the venv-CLI but occasionally run
# `docker compose up`, prefer this one-shot override (cleaner than editing .env):
#
#   DB_HOST=postgres docker compose --profile bot up -d
#
# Symptom of the wrong value inside compose: `tg_parser` container restarts
# in a loop with `Connection refused` on 127.0.0.1:5432 while bot/mcp stay
# "healthy" (their healthchecks don't touch DB) — masking the issue.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tg_parser
DB_USER=tg_parser_user
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# =============================================================================
# Custom Prompts Directory (опционально)
# =============================================================================
# По умолчанию используется ./prompts/
# Можно переопределить для кастомных промптов

# PROMPTS_DIR=/path/to/custom/prompts


# =============================================================================
# Embedding / RAG Configuration (P5)
# =============================================================================

# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BATCH_SIZE=100


# =============================================================================
# Hybrid Retrieval (F5-A Phase 1)
# =============================================================================
# Hybrid search combines keyword FTS (ts_rank_cd) with semantic pgvector
# results via Reciprocal Rank Fusion. Disable to fall back to semantic-only.
#
# HYBRID_ENABLED=true
# HYBRID_RRF_K=60                         # RRF constant; typical 30-100
# FTS_LANGUAGES=russian,english           # Informational; baked into search_vector DDL


# =============================================================================
# RAG Relevance Tuning (F5-A Phase 2)
# =============================================================================
# Fine-tune keyword search cutoffs and RAG type-quota behaviour in answer().
#
# FTS_MIN_RANK=0.0                        # ts_rank_cd cutoff (0.0 = no cutoff); typical useful range 0.001-0.05
# RAG_TOPIC_QUOTA=2                       # Reserve N topic cards in answer() context; remainder goes to messages
# RAG_SEARCH_OVERFETCH_FACTOR=2           # answer() fetches limit * factor before quota split (headroom)


# =============================================================================
# F5-A Phase 3: Deduplication
# =============================================================================
# Enable content-hash dedup in the processing pipeline (within-channel only).
# When a duplicate is detected the LLM-generated document is dropped (not
# written to processed_documents) and the existing record is returned.
#
# DEDUP_ENABLED=true
# DEDUP_STRIP_URL_QUERY=true              # Strip "?query#fragment" from URLs before hashing


# =============================================================================
# F5-C: Evolving Topic Summaries (2026-04-26)
# =============================================================================
# When a TopicCard accumulates ≥ N new supporting items, it re-summarizes
# itself (LLM call), re-embeds the result, and persists an append-only
# topic_card_versions snapshot.  Hook runs between run_topic_embedding and
# run_watchlist_check_for_channel — F11 watchlist scoring uses the freshest
# summary.  Default model is intentionally cheap (gpt-4o-mini, ~$0.15/1M).
#
# RESUMMARIZE_ENABLED=true                # Kill-switch (counter still bumps when false)
# RESUMMARIZE_TRIGGER_N=5                 # New items before topic becomes a candidate
# RESUMMARIZE_MAX_AGE_DAYS=0             # F5-C P2 (#15 #4): time-based trigger; 0=disabled, ~14 prod
# RESUMMARIZE_INPUT_WINDOW_N=10           # How many top-N items feed the LLM input
# RESUMMARIZE_MAX_PER_TICK=10             # Cap on topics re-summarized per tick per channel
# RESUMMARIZE_MAX_DURATION_S=60           # Wall-clock cap (seconds) per tick
# RESUMMARIZE_MAX_TOKENS_PER_TICK=50000   # Token cap per tick (runaway-protection)


# === F5-B Near-duplicate observation (Phase 0, ADR-0016) ===================
# Observation-only counter: measures near-duplicate rate (intra + cross axes)
# via pgvector cosine; never hides or mutates anything. Phase 1 (real dedup)
# is gated on >=7 days of this data showing >=5% near-dup on the dominant axis.
#
# NEAR_DUP_OBSERVE_ENABLED=true           # Master switch for the Phase 0 observer
# NEAR_DUP_SIMILARITY_THRESHOLD=0.92      # Cosine threshold for a near-dup hit
# NEAR_DUP_WINDOW_N=50                    # Sliding-window size per axis (recall vs cost)


# =============================================================================
# F11: Topic Watchlist scoring
# =============================================================================
# Hybrid score: combined = keyword_weight*keyword + semantic_weight*semantic
# (clamped to [0,1]). Rebalance keyword vs semantic without code changes when
# the embedding model under-scores the corpus language. DEFAULT_THRESHOLD is the
# cutoff applied to NEW interests when the caller omits an explicit threshold
# (existing interests keep their stored value).
#
# WATCHLIST_KEYWORD_WEIGHT=0.4            # Keyword component weight (0..1)
# WATCHLIST_SEMANTIC_WEIGHT=0.6          # Semantic (cosine) component weight (0..1)
# WATCHLIST_DEFAULT_THRESHOLD=0.6        # Default combined-score cutoff for new interests


# =============================================================================
# Topicization Tuning
# =============================================================================
# TOPICIZATION_BATCH_SIZE=50           # Max docs per LLM call in discover_new_topics

# Pipeline Versions (не изменять без необходимости)
# =============================================================================

# PIPELINE_VERSION_PROCESSING=processing:v1.0.0
# PIPELINE_VERSION_TOPICIZATION=topicization:v1.0.0
# EXPORT_VERSION=export:v1.0.0


# =============================================================================
# Multi-Tenancy (F4)
# =============================================================================
# User management with roles (admin/user) and per-user channel limits.
# Run `tg-parser migrate-users` after enabling to map existing credentials.

# Default channel limit for new users (when users.max_channels is NULL)
# DEFAULT_MAX_CHANNELS=20


# =============================================================================
# MCP Server Configuration (D1)
# =============================================================================
# MCP server for AI agents (Claude Desktop, Cursor, etc.)
# Default transport: stdio (for local use). Use streamable-http for remote.

# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8080
# MCP_PATH=/mcp

# Bearer-token auth (for streamable-http transport)
# MCP_AUTH_ENABLED=false
# MCP_AUTH_TOKENS={"your-secret-token": "client-name"}


# =============================================================================
# Telegram Bot Configuration (Phase 3)
# =============================================================================
# Bot uses Gemini for agentic reasoning and tool-calling.
# Get bot token from @BotFather: https://t.me/BotFather
#
# SINGLE-OWNER TOKEN RULE: exactly ONE deployed poller per TELEGRAM_BOT_TOKEN.
# The production VPS owns the production token. Local/dev MUST use a SEPARATE
# BotFather token here (or not run the `bot` profile at all) — sharing one token
# across hosts causes TelegramConflictError (BUG-061). See PRODUCTION_DEPLOYMENT.md
# § "Single-owner token rule".

# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Allowlist: comma-separated Telegram user IDs (empty = allow all, dev only!)
# BOT_ALLOWED_USERS=123456789,987654321

# Bot-specific settings
# BOT_REQUEST_TIMEOUT=60
# BOT_RATE_LIMIT=10
# BOT_GEMINI_MODEL=gemini-2.5-flash
# BOT_GEMINI_MAX_OUTPUT_TOKENS=8192        # Bumped 4096→8192 in Session E (BUG-006).
# BOT_GEMINI_THINKING_BUDGET=0             # 0 disables thinking (HG-2 hotfix); empty/unset uses model default.


# =============================================================================
# Reverse Proxy — Domain Configuration (Phase 1: Caddy)
# =============================================================================
# Used by Caddy service (profile: production) for automatic TLS (Let's Encrypt).
# For local development these default to *.localhost (Caddy issues self-signed certs).

# DOMAIN_MCP=mcp.example.com
# DOMAIN_API=api.example.com
# DOMAIN_GRAFANA=grafana.example.com


# =============================================================================
# Monitoring — Grafana (Phase 1)
# =============================================================================

# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_PORT=3000
