      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(tg_resummarize_tokens_total[1h])) by (channel_id, token_type)",
          "legendFormat": "{{channel_id}} {{token_type}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Re-summarize tokens (cumulative by channel)",
      "description": "Cumulative re-summarize token spend broken out by channel_id (Wave 2 channel_id label) since process start. channel_id=\"-\" = card unknown.",
