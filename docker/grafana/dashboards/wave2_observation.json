{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "F5-B Phase 0 — Near-duplicate dedup (observation-only)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "title": "Near-dup 7d rate vs 5% gate (T2)",
      "description": "T2 GATE signal. near-dup detections / processed documents over a trailing 7d window, per axis. Denominator = tg_parser_messages_processed_total{status=\"success\"} (best available proxy for embedded ProcessedDocuments; there is no dedicated processed-document counter). Green < 5%, RED >= 5% means the dominant axis crossed the threshold -> build F5-B Phase 1.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(increase(tg_dedup_near_duplicates_detected_total[7d])) by (dimension) / scalar(sum(increase(tg_parser_messages_processed_total{status=\"success\"}[7d])))",
          "legendFormat": "{{dimension}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Near-dup 7d rate per axis (5% threshold marker)",
      "description": "Same T2 gate ratio plotted over time with a horizontal 5% threshold line. The series is a trailing 7d window so it moves slowly; once a dimension line sits above the red 5% mark the gate is met.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(tg_dedup_near_duplicates_detected_total[7d])) by (dimension) / scalar(sum(increase(tg_parser_messages_processed_total{status=\"success\"}[7d])))",
          "legendFormat": "{{dimension}} 7d rate",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Near-dup detections (rate by dimension)",
      "description": "intra = same channel, cross = sibling channels. Observation-only counter tg_dedup_near_duplicates_detected_total{channel_id, method, dimension}.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(tg_dedup_near_duplicates_detected_total[1h])) by (dimension)",
          "legendFormat": "{{dimension}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Near-dup detections (24h increase by channel/dimension)",
      "description": "Per-channel breakdown of observed near-duplicates over the last 24h.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(tg_dedup_near_duplicates_detected_total[24h])) by (channel_id, dimension)",
          "legendFormat": "{{channel_id}} [{{dimension}}]",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Near-dup similarity distribution (heatmap)",
      "description": "Distribution of cosine similarity for observed near-duplicate pairs (tg_dedup_near_duplicate_similarity, buckets 0.90..1.0).",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "mode": "scheme", "scheme": "Spectral", "steps": 64 },
        "yAxis": { "unit": "short" }
      },
      "targets": [
        {
          "expr": "sum(increase(tg_dedup_near_duplicate_similarity_bucket[1h])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Near-dup similarity quantiles by dimension",
      "description": "p50 / p90 of the observed near-duplicate similarity per axis.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 3,
          "custom": { "drawStyle": "line", "fillOpacity": 5 }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(tg_dedup_near_duplicate_similarity_bucket[6h])) by (le, dimension))",
          "legendFormat": "{{dimension}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(tg_dedup_near_duplicate_similarity_bucket[6h])) by (le, dimension))",
          "legendFormat": "{{dimension}} p90",
          "refId": "B"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "T7 F5-C P2 — Re-summarize freshness (RESUMMARIZE_MAX_AGE_DAYS=14)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "panels": []
    },
    {
      "title": "Re-summarize rate by channel & outcome",
      "description": "tg_resummarize_total{channel_id, outcome, trigger}. outcome in {ok, locked, no_card, no_bundle, empty_scope, llm_error, version_raced, unknown}. Counter-vs-age trigger split is in the dedicated 'Re-summarize trigger split' panel below.",
