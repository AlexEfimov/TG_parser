      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Re-summarize outcomes (24h increase)",
      "description": "Outcome mix over the last 24h. Watch for llm_error / version_raced spikes.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "fieldConfig": {
        "defaults": {
