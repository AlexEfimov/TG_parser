{
  "ignorePatterns": [
    { "pattern": "^http://localhost" },
    { "pattern": "\\.py($|#)" },
    { "pattern": "\\.ya?ml($|#)" },
    { "pattern": "\\.sql($|#)" },
    { "pattern": "\\.json($|#)" },
    { "pattern": "\\.sh($|#)" },
    { "pattern": "^tg_parser/" },
    { "pattern": "^migrations/" },
    { "pattern": "^scripts/" },
    { "pattern": "^tests/" },
    { "pattern": "^benchmarks/" },
    { "pattern": "^\\.env" },
    { "pattern": "^Makefile$" },
    { "pattern": "^docker-compose" }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206]
}
