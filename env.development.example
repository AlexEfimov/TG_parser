# DEPRECATED — SQLite development template (pre-Session 39)
#
# TG_parser is PostgreSQL-only since v4.x. Do NOT use this file.
# Copy .env.example instead:
#
#   cp .env.example .env
#
# See docs/GETTING_STARTED.md and docs/guides/SELF_HOST.md.

# =============================================================================
# Database Configuration (Development: SQLite) — NOT SUPPORTED
# =============================================================================

DB_TYPE=sqlite

# SQLite database files (stored in project root)
INGESTION_STATE_DB_PATH=ingestion_state.sqlite
RAW_STORAGE_DB_PATH=raw_storage.sqlite
PROCESSING_STORAGE_DB_PATH=processing_storage.sqlite

# =============================================================================
# LLM Configuration
# =============================================================================

LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini  # Cheaper model for development

OPENAI_API_KEY=sk-...

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# =============================================================================
# Telegram Configuration
# =============================================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# =============================================================================
# See .env.example for the current PostgreSQL-based template
# =============================================================================
